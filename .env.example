# GEMINI_API_KEY: Google Gemini API Anahtarı (Zorunlu)
# Kod içine kesinlikle yazılmaz, buradan okunur.
GEMINI_API_KEY="your_gemini_api_key_here"

# AUTH_DIR: WhatsApp kimlik doğrulama / session verilerinin kalıcı saklanacağı klasör yolu
# Northflank'ta persistent volume yolu: /data/auth
# Varsayılan: ./data/auth veya ./auth_info_baileys
AUTH_DIR="/data/auth"

# PORT: HTTP server portu (Northflank ve health check için)
PORT="3000"

# PAIRING_NUMBER: (Opsiyonel) QR kod yerine 8 haneli pairing code ile bağlanmak isterseniz
# Ülke koduyla birlikte numaranızı yazın (örn: 905xxxxxxxxx)
PAIRING_NUMBER=""

# APP_URL: Servis URL'i
APP_URL="http://localhost:3000"

