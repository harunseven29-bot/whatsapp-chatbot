# Google Gemini API Key (Zorunlu)
# https://aistudio.google.com adresinden ücretsiz alabilirsiniz
GEMINI_API_KEY=your_gemini_api_key_here

# Kalıcı Auth / Session Klasörü
# Yerel kullanım: ./auth
# Wispbyte Free / Container: /home/container/auth veya ./auth
AUTH_DIR=./auth

# Telefon numarasıyla 8 haneli Pairing Code almak için:
# Örnek: 905102237729 (Sadece rakamlar, ülke koduyla birlikte)
PAIRING_NUMBER=905102237729

# HTTP Port (Wispbyte / VPS varsayılan portu)
PORT=3000

# Node Environment
NODE_ENV=production
