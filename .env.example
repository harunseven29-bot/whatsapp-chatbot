# Google Gemini API Key (Zorunlu)
# https://aistudio.google.com adresinden ücretsiz alabilirsiniz
GEMINI_API_KEY=your_gemini_api_key_here

# Kalıcı Auth / Session Klasörü
# Yerel kullanım: ./auth
# Wispbyte / VPS / Container: /data/auth veya ./auth
AUTH_DIR=./auth

# Public Base URL (Wispbyte / Domain / IP)
# Örnek: https://bot.wispbyte.com veya http://123.45.67.89:3000
PUBLIC_BASE_URL=

# HTTP Port
PORT=3000

# Node Environment
NODE_ENV=production
